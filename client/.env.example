# ===== CLIENTE (React + Vite + Capacitor) =====
# Copie para client\.env e preencha. Nunca suba o .env para o GitHub.
# Estes valores são gravados no app na hora do build (mudou? gere o APK de novo).

# Supabase -> Settings -> API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Endereço do servidor Node/Socket.io:
#  - Navegador no PC:       http://localhost:3001
#  - Emulador Android:      http://10.0.2.2:3001
#  - Celular físico (Wi-Fi): http://IP-DO-SEU-PC:3001  (ex.: http://192.168.0.10:3001)
#  - Servidor publicado:    https://seu-servidor.com
VITE_SOCKET_URL=http://localhost:3001
